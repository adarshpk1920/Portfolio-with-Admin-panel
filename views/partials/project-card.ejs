<article class="project-card reveal" data-category="<%= p.category_slug || 'uncategorised' %>" data-tilt style="--d: <%= (i % 3) * 80 %>ms">
  <a href="/projects/<%= p.slug %>" class="project-link" aria-label="View case study: <%= p.title %>">
    <div class="project-media">
      <% if (p.cover_image) { %>
        <img src="<%= p.cover_image %>" alt="" loading="lazy" width="1200" height="800">
      <% } else { %>
        <div class="project-placeholder" aria-hidden="true"><%= p.title.charAt(0) %></div>
      <% } %>
      <span class="project-view" aria-hidden="true">View case study →</span>
    </div>
    <div class="project-body">
      <div class="project-meta">
        <span class="chip"><%= p.category_name || 'Project' %></span>
        <% if (p.year) { %><span class="muted small"><%= p.year %></span><% } %>
      </div>
      <h3><%= p.title %></h3>
      <p class="muted"><%= p.summary %></p>
      <% if (p.techList && p.techList.length) { %>
        <ul class="tags" aria-label="Technologies">
          <% p.techList.slice(0, 4).forEach(t => { %><li><%= t %></li><% }) %>
        </ul>
      <% } %>
    </div>
  </a>
</article>
