<footer class="site-footer">
  <div class="container footer-inner">
    <div>
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"><%= (site.site_name || 'P').trim().charAt(0) %></span><span class="brand-name"><%= site.site_name %></span></a>
      <p class="muted small">© <%= year %> <%= site.site_name %>. All rights reserved.</p>
    </div>
    <div class="socials">
      <% [['social_github', 'GitHub'], ['social_linkedin', 'LinkedIn'], ['social_dribbble', 'Dribbble']].forEach(([key, label]) => { if (site[key]) { %>
        <a href="<%= site[key] %>" target="_blank" rel="noopener noreferrer"><%= label %></a>
      <% } }) %>
    </div>
    <a class="back-top" href="#main" data-back-top aria-label="Back to top">↑</a>
  </div>
</footer>
<script src="/js/main.js" defer></script>
</body>
</html>
