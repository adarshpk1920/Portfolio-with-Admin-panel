<% const home = currentPath === '/' ? '' : '/'; %>
<header class="site-header" data-header>
  <div class="container nav">
    <a class="brand" href="/" aria-label="<%= site.site_name %> home">
      <span class="brand-mark" aria-hidden="true"><%= (site.site_name || 'P').trim().charAt(0) %></span>
      <span class="brand-name"><%= site.site_name %></span>
    </a>
    <nav class="nav-links" id="nav-menu" data-nav>
      <a href="<%= home %>#about">About</a>
      <a href="<%= home %>#services">Services</a>
      <a href="<%= home %>#portfolio">Portfolio</a>
      <a href="<%= home %>#contact">Contact</a>
      <a class="btn btn-sm btn-primary nav-cta" href="<%= home %>#contact">Let's talk</a>
    </nav>
    <div class="nav-actions">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Toggle colour theme">
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <button class="icon-btn menu-toggle" type="button" data-menu-toggle aria-controls="nav-menu" aria-expanded="false" aria-label="Open menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
