<%- include('partials/top') %>
<% const isNew = !testimonial.id; const err = (k) => errors[k] ? `<span class="field-error">${errors[k]}</span>` : ''; %>
<% const initials = (n) => (n || '').split(/\s+/).filter(Boolean).map((w) => w[0]).join('').slice(0, 2).toUpperCase() || '?'; %>

<div class="toolbar">
  <a class="link" href="/admin/testimonials">← All testimonials</a>
</div>

<% if (Object.keys(errors).filter(k => errors[k]).length) { %>
  <div class="alert alert-error" role="alert">Please fix the highlighted fields below.<% if (errors._files) { %> <%= errors._files %><% } %></div>
<% } %>

<form class="editor" method="post" action="<%= isNew ? '/admin/testimonials' : `/admin/testimonials/${testimonial.id}` %>" enctype="multipart/form-data" data-testimonial-form novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="editor-main">
    <section class="card stack">
      <h2 class="card-title">Testimonial</h2>
      <div class="form-grid-2">
        <label class="field <%= errors.name ? 'has-error' : '' %>"><span>Client name <em>*</em></span>
          <input name="name" value="<%= testimonial.name %>" required maxlength="80" placeholder="e.g. Priya Raman" data-t-name>
          <%- err('name') %>
        </label>
        <label class="field"><span>Role &amp; company</span>
          <input name="role" value="<%= testimonial.role %>" maxlength="120" placeholder="e.g. Founder, Lumen Analytics" data-t-role>
        </label>
      </div>
      <label class="field <%= errors.quote ? 'has-error' : '' %>"><span>What they said <em>*</em></span>
        <textarea name="quote" rows="5" maxlength="600" required placeholder="Paste the client's words here…" data-t-quote><%= testimonial.quote %></textarea>
        <small class="muted"><span data-t-count>0</span>/600 · Short and specific quotes work best (1–3 sentences).</small>
        <%- err('quote') %>
      </label>
      <fieldset class="field star-field">
        <legend>Rating</legend>
        <div class="star-input" data-t-rating>
          <% [5, 4, 3, 2, 1].forEach((n) => { %>
            <input type="radio" id="rating-<%= n %>" name="rating" value="<%= n %>" <%= Number(testimonial.rating) === n ? 'checked' : '' %>>
            <label for="rating-<%= n %>" title="<%= n %> star<%= n > 1 ? 's' : '' %>">★<span class="sr-only"><%= n %> star<%= n > 1 ? 's' : '' %></span></label>
          <% }) %>
        </div>
      </fieldset>
    </section>

    <section class="card stack">
      <h2 class="card-title">Live preview</h2>
      <p class="muted small">This is how the card will look in the homepage slider.</p>
      <figure class="t-preview" data-t-preview>
        <div class="t-preview-stars" data-p-stars>★★★★★</div>
        <blockquote data-p-quote><%= testimonial.quote || 'The testimonial text will appear here.' %></blockquote>
        <figcaption>
          <span class="t-preview-avatar" data-p-avatar><% if (testimonial.avatar) { %><img src="<%= testimonial.avatar %>" alt=""><% } else { %><%= initials(testimonial.name) %><% } %></span>
          <span><strong data-p-name><%= testimonial.name || 'Client name' %></strong><small class="muted" data-p-role><%= testimonial.role || 'Role, Company' %></small></span>
        </figcaption>
      </figure>
    </section>
  </div>

  <aside class="editor-side">
    <section class="card stack sticky">
      <h2 class="card-title">Visibility</h2>
      <label class="switch-field">
        <input type="checkbox" name="published" value="1" <%= testimonial.published ? 'checked' : '' %>>
        <span class="switch" aria-hidden="true"></span>
        <span><strong>Show on website</strong><small class="muted">Appears in the homepage slider</small></span>
      </label>
      <button class="btn btn-primary btn-block" type="submit"><span class="btn-label"><%= isNew ? 'Add testimonial' : 'Save changes' %></span><span class="spinner" aria-hidden="true"></span></button>
      <% if (!isNew) { %><p class="muted small center">Added <%= formatDate(testimonial.created_at) %> · Updated <%= formatDate(testimonial.updated_at) %></p><% } %>
    </section>

    <section class="card stack">
      <h2 class="card-title">Client photo</h2>
      <div class="avatar-preview" data-avatar-preview>
        <% if (testimonial.avatar) { %><img src="<%= testimonial.avatar %>" alt="Current photo"><% } else { %><span><%= initials(testimonial.name) %></span><% } %>
      </div>
      <label class="btn btn-ghost btn-block file-btn">
        <input type="file" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" data-avatar-input>
        <%= testimonial.avatar ? 'Replace photo' : 'Upload photo' %>
      </label>
      <% if (!isNew && testimonial.avatar) { %>
        <label class="remove-check"><input type="checkbox" name="remove_avatar" value="1"> Remove current photo</label>
      <% } %>
      <small class="muted">Optional. A square image works best (at least 200 × 200 px, max <%= maxUploadMb %> MB). Without a photo, the client's initials are shown.</small>
    </section>
  </aside>
</form>

<% if (!isNew) { %>
  <section class="card danger-zone">
    <div><h2 class="card-title">Delete testimonial</h2><p class="muted small">Permanently removes this testimonial and its photo.</p></div>
    <form method="post" action="/admin/testimonials/<%= testimonial.id %>/delete" data-confirm="Delete the testimonial from &quot;<%= testimonial.name %>&quot; permanently?">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-danger" type="submit">Delete testimonial</button>
    </form>
  </section>
<% } %>
<%- include('partials/bottom') %>
