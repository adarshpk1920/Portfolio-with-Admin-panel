# Copy to .env for local development. On your host, set these as environment variables.

PORT=3000
NODE_ENV=development

# REQUIRED in production: a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
SESSION_SECRET=change-me-to-a-long-random-string

# Admin account created on first start (only if no users exist yet).
ADMIN_EMAIL=admin@portfolio.dev
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Site Admin

# Where the SQLite database and uploaded images are stored. Point this at a persistent volume in production.
DATA_DIR=./data

# Max size per uploaded image in MB
MAX_UPLOAD_MB=5

# Set to 1 when running behind a reverse proxy (Render, Railway, Fly, Nginx). Automatically on when NODE_ENV=production.
TRUST_PROXY=0
